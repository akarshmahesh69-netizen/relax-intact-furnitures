---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---
<Layout
  page="products"
  title="Products | Relax Intact Furnitures"
  description="The full Relax Intact range: executive, computer and visitor chairs, office tables, cupboards and vertical blinds. Manufactured and supplied directly in Bangalore."
  ogTitle="Products | Relax Intact Furnitures"
  ogDescription="The full range of office chairs, tables, cupboards and blinds, manufactured and supplied directly in Bangalore."
>

  <!-- ================= PRODUCTS ================= -->
  <section class="section products-page-intro">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Products</span>
        <h1 id="heroTitle" tabindex="-1">The full range</h1>
        <p>Manufactured and supplied directly, then kept in working order. We're adding more varieties here as they're photographed. Call or use the form below for anything not yet listed.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="products">
    <div class="wrap">

      <div class="category" id="seating">
        <div class="cat-head"><h2>Office &amp; Executive Seating</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/executive-chair.webp" width="537" height="851" alt="Tan leather high-back executive chair with a polished aluminium base" loading="lazy" decoding="async" /></div>
            <h3>Executive Chairs</h3>
            <p>High-back seating for cabins and leadership spaces, in leather or premium fabric.</p>
            <div class="shelf-chips"><span>High-back</span><span>Leather or fabric</span><span>Padded headrest</span></div>
            <button class="card-enquire" data-req="Executive Chairs">Enquire →</button>
          </article>
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/product-computer-chair.webp" width="1256" height="1256" alt="Black mesh computer chair with a headrest and adjustable armrests" loading="lazy" decoding="async" /></div>
            <h3>Computer Chairs</h3>
            <p>Adjustable seating for computer workstations and shared desks.</p>
            <div class="shelf-chips"><span>Mesh back</span><span>Headrest</span><span>Adjustable armrests</span></div>
            <button class="card-enquire" data-req="Computer Chairs">Enquire →</button>
          </article>
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/product-visitor-chair.webp" width="1300" height="1211" alt="Black leather visitor chair on a chrome cantilever frame" loading="lazy" decoding="async" /></div>
            <h3>Visitor Chairs</h3>
            <p>Bench and standalone seating for receptions, waiting areas and meeting rooms.</p>
            <div class="shelf-chips"><span>Cantilever frame</span><span>Reception</span><span>Meeting rooms</span></div>
            <button class="card-enquire" data-req="Visitor Chairs">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="category" id="office-furniture">
        <div class="cat-head"><h2>Office Furniture</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/desk.webp" width="970" height="498" alt="Executive office desk in walnut and charcoal with a lockable side drawer unit" loading="lazy" decoding="async" /></div>
            <h3>Office Tables</h3>
            <p>Desks, workstations and office solutions for offices of any size.</p>
            <div class="shelf-chips"><span>Cabin desk</span><span>Side drawer unit</span><span>Cable management</span></div>
            <button class="card-enquire" data-req="Office Tables">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="category" id="storage">
        <div class="cat-head"><h2>Storage</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/cupboard.webp" width="599" height="788" alt="Walnut and charcoal storage cupboard with lockable doors and glass-front shelves" loading="lazy" decoding="async" /></div>
            <h3>Cupboards</h3>
            <p>Storage units and filing cabinets for documents, stationery and supplies.</p>
            <div class="shelf-chips"><span>Lockable</span><span>Glass-door shelves</span><span>Filing</span></div>
            <button class="card-enquire" data-req="Cupboards">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="category" id="sofas">
        <div class="cat-head"><h2>Sofas &amp; Lounge Seating</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/sofa.webp" width="781" height="383" alt="Three-seater fabric sofa with wooden feet" loading="lazy" decoding="async" /></div>
            <h3>Sofas &amp; Lounge Seating</h3>
            <p>Sofas, lounge chairs and multi-seater chairs.</p>
            <div class="shelf-chips"><span>Sofas</span><span>Lounge chairs</span><span>Multi-seater chairs</span></div>
            <button class="card-enquire" data-req="Sofas &amp; Lounge Seating">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="category" id="cafe">
        <div class="cat-head"><h2>Café &amp; Bar Seating</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/bar-stool.webp" width="594" height="826" alt="Bar stool with a gold frame and white seat" loading="lazy" decoding="async" /></div>
            <h3>Café Chairs &amp; Bar Stools</h3>
            <p>Seating for cafés and bars.</p>
            <div class="shelf-chips"><span>Café chairs</span><span>Bar stools</span></div>
            <button class="card-enquire" data-req="Café &amp; Bar Seating">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="category" id="blinds">
        <div class="cat-head"><h2>Vertical Blinds</h2></div>
        <div class="shelf">
          <article class="shelf-item">
            <div class="shelf-photo"><img src="/images/cutouts/blinds.webp" width="718" height="701" alt="Vertical window blinds in a warm grey woven fabric" loading="lazy" decoding="async" /></div>
            <h3>Vertical Blinds</h3>
            <p>Window blinds fitted for cabins, meeting rooms and open-plan offices.</p>
            <div class="shelf-chips"><span>Fabric vanes</span><span>Cabins</span><span>Meeting rooms</span><span>Supply &amp; installation</span></div>
            <button class="card-enquire" data-req="Vertical Blinds">Enquire →</button>
          </article>
        </div>
      </div>

      <div class="unsure-row">
        <p>Need something built to size, or a chair repaired? <a class="unsure-link" href="/#contact">Tell us what you need →</a></p>
      </div>

    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="section section-alt band-rose" id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow">Contact</span>
        <h2>Let's set up your workspace.</h2>
        <p>Tell us what you need. We'll get back with options, pricing and lead times.</p>

        <div class="contact-info">
          <div class="contact-info-row">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <span>Call us at <a href="tel:+919886490295">98864 90295</a></span>
          </div>
          <div class="contact-info-row">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>
            <span>Relax Intact, Manufacturers of Office Furnitures, Lalbagh Fort Road, Minerva Circle, Bangalore 560 004</span>
          </div>
          <div class="contact-info-row">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4h16v16H4z" stroke="currentColor" stroke-width="1.6"/><path d="M4 6l8 7 8-7" stroke="currentColor" stroke-width="1.6"/></svg>
            <span>Prefer email? <a href="#contact">Use the enquiry form →</a></span>
          </div>
        </div>

        <div class="contact-image">
          <img src="https://images.pexels.com/photos/31236091/pexels-photo-31236091.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/31236091/pexels-photo-31236091.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/31236091/pexels-photo-31236091.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 900px) 92vw, 50vw" width="800" height="450" alt="Warm, comfortable workspace with an ergonomic chair and desk" loading="lazy" decoding="async" />
        </div>
      </div>

      <div>
        <EnquiryForm />
      </div>
    </div>
  </section>

</Layout>

<style>
/* ============================================================
   PRODUCTS PAGE — full catalogue, grouped by category on a "shelf":
   a dashed rail under every photo, echoing the home-page hero orbit's own gold rail/link lines,
   so this page reads as a continuation of that world rather than a different component library.
   ============================================================ */
.products-page-intro{ padding-top: var(--space-5); padding-bottom: 0; }
.products-page-intro .eyebrow::before{ display: none; }
.products-page-intro .section-head{ margin-bottom: var(--space-3); }
#products.section{ padding-top: var(--space-3); padding-bottom: var(--space-5); }
.category{ padding: var(--space-4) 0; border-bottom: 1px solid var(--line); }
.category:last-of-type{ border-bottom: none; }
.cat-head{ margin-bottom: var(--space-3); }
.cat-head h2{
  font-size: 0.95rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--maroon-dark);
}
.shelf{
  display:flex; flex-wrap:wrap; gap: 32px 40px;
  align-items:flex-end; position:relative;
}
.shelf-item{
  flex: 1 1 190px; max-width: 240px;
  display:flex; flex-direction:column; align-items:center; text-align:center;
}
.js .shelf-item.reveal{
  opacity:0; transform: scale(0.93) rotate(-1.3deg);
  transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
  transition-delay: calc(var(--i, 0) * 90ms);
}
.js .shelf-item.reveal.in{ opacity:1; transform:none; }
.shelf-photo{
  --tile: var(--maroon-tint);
  background: radial-gradient(120% 90% at 50% 105%, rgba(255,255,255,0.6), rgba(255,255,255,0) 62%), var(--tile);
  border-radius: var(--radius-md); padding: 14px;
  width:100%; height: clamp(160px, 17vw, 220px);
  display:flex; align-items:center; justify-content:center; margin-bottom: 14px;
}
.category:nth-child(even) .shelf-photo{ --tile: var(--gold-tint); }
.shelf-photo img{
  max-width:100%; max-height:100%; width:auto; height:auto; display:block;
  mix-blend-mode: multiply; transition: transform 0.45s var(--ease-out);
}
.shelf-item:hover .shelf-photo img{ transform: translateY(-5px); }
.shelf-item h3{ font-size: 1.4rem; margin-bottom: 6px; }
.shelf-item > p{ font-size: 0.88rem; margin-bottom: 12px; max-width: 24ch; }
.shelf-chips{ display:flex; flex-wrap:wrap; justify-content:center; gap: 6px; margin-bottom: 14px; }
.shelf-chips span{
  font-size: 0.72rem; font-weight: 600; color: var(--maroon-dark);
  background: var(--maroon-tint); border-radius: 100px; padding: 4px 10px;
}
.shelf-item .card-enquire{ align-self: center; }

.unsure-row{ text-align:center; padding-top: var(--space-3); }
.unsure-row p{ font-size: 0.95rem; color: var(--ink-soft); }
.unsure-link{
  background:none; border:none; padding:0; font-family:inherit;
  font-size: 0.95rem; font-weight:700; color: var(--maroon);
  border-bottom: 1px solid var(--maroon); padding-bottom: 2px;
}
a.unsure-link{ text-decoration:none; }
.unsure-link:hover{ color: var(--maroon-dark); border-color: var(--maroon-dark); }

@media (max-width: 900px){
  .category{ padding: var(--space-3) 0; }
  .shelf{ gap: 28px 24px; justify-content: center; }
}
</style>
