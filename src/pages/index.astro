---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---
<Layout
  page="home"
  title="Relax Intact Furnitures | Office Furniture & Workplace Maintenance, Bangalore"
  description="Relax Intact manufactures and supplies office chairs, tables, cupboards and blinds, and services them with repair, servicing and cleaning. Bangalore."
  ogTitle="Relax Intact Furnitures | Office Furniture & Workplace Maintenance, Bangalore"
  ogDescription="Office chairs, tables, cupboards and blinds, made in Bangalore, plus repair, servicing and cleaning from the same vendor."
>

  <!-- ================= HERO ================= -->
  <section class="hero" id="home" aria-labelledby="heroTitle">
    <div class="wrap hero-grid">
      <div class="hero-left">
        <div class="hero-copy">
          <div class="hero-photo-mobile" aria-hidden="true"></div>
          <div class="hero-head">
            <p class="eyebrow hero-eyebrow">FURNITURE MANUFACTURING · SUPPLY · SERVICE</p>
            <h1 id="heroTitle" class="hero-title" tabindex="-1"><span>A Complete Partner</span><span>for <em>Better Spaces</em>.</span></h1>
          </div>
          <p class="hero-lede"><span class="lede-full">From crafted furniture and custom requirements to reliable supply and ongoing care, we bring the entire furniture journey all together under one roof.</span><span class="lede-short">From crafted furniture to reliable supply and ongoing care, the whole furniture journey under one roof.</span></p>
          <div class="hero-cta-stack">
            <button type="button" class="btn btn-guide" data-req="Free furniture guide">
              <svg class="guide-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h8l4 4v14H6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v4h4M9 12h6M9 16h6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>Free Furniture Guide</span>
              <span class="arrow" aria-hidden="true">→</span>
            </button>
            <div class="hero-ctas">
              <a href="#products" class="btn btn-primary btn-lg">Explore products</a>
              <a href="#contact" class="btn btn-outline btn-lg">Talk to us <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>

      <div class="orbit-stage" id="orbit" role="group" aria-label="Product showcase">
        <svg class="orbit-lines" aria-hidden="true" focusable="false"><g class="rails"></g><g class="links"></g></svg>

        <button type="button" class="orbit-item" data-id="executive" data-product-req="Executive Chairs" data-name="Executive chairs" data-desc="High-back seating for cabins and leadership spaces, in leather or premium fabric." data-chips="High-back|Leather or fabric|Padded headrest">
          <span class="oi-body"><img class="oi-img" src="/images/product-executive-chair.webp" width="1224" height="1290" alt="Tan leather high-back executive chair with a polished aluminium base" decoding="async" fetchpriority="high" /></span>
          <span class="oi-label" aria-hidden="true">Executive chairs</span>
        </button>
        <button type="button" class="orbit-item" data-id="tables" data-product-req="Office Tables" data-name="Office tables" data-desc="Workstations, cabin tables and modular desks for offices of any size." data-chips="Cabin desk|Side drawer unit|Cable management">
          <span class="oi-body"><img class="oi-img" src="/images/product-desk.webp" width="1536" height="1024" alt="Executive office desk in walnut and charcoal with a lockable side drawer unit" decoding="async" /></span>
          <span class="oi-label" aria-hidden="true">Office tables</span>
        </button>
        <button type="button" class="orbit-item" data-id="cupboards" data-product-req="Cupboards" data-name="Cupboards" data-desc="Storage units and filing cabinets for documents, stationery and supplies." data-chips="Lockable|Glass-door shelves|Filing">
          <span class="oi-body"><img class="oi-img" src="/images/product-cupboard.webp" width="1299" height="1211" alt="Walnut and charcoal storage cupboard with lockable doors and glass-front shelves" decoding="async" /></span>
          <span class="oi-label" aria-hidden="true">Cupboards</span>
        </button>
        <button type="button" class="orbit-item" data-id="computer" data-product-req="Computer Chairs" data-name="Computer chairs" data-desc="Adjustable seating for computer workstations and shared desks." data-chips="Mesh back|Headrest|Adjustable armrests">
          <span class="oi-body"><img class="oi-img" src="/images/product-computer-chair.webp" width="1256" height="1256" alt="Black mesh computer chair with a headrest and adjustable armrests" decoding="async" /></span>
          <span class="oi-label" aria-hidden="true">Computer chairs</span>
        </button>
        <button type="button" class="orbit-item" data-id="visitor" data-product-req="Visitor Chairs" data-name="Visitor chairs" data-desc="Bench and standalone seating for receptions, waiting areas and meeting rooms." data-chips="Cantilever frame|Reception|Meeting rooms">
          <span class="oi-body"><img class="oi-img" src="/images/product-visitor-chair.webp" width="1300" height="1211" alt="Black leather visitor chair on a chrome cantilever frame" decoding="async" /></span>
          <span class="oi-label" aria-hidden="true">Visitor chairs</span>
        </button>
        <button type="button" class="orbit-item" data-id="blinds" data-product-req="Vertical Blinds" data-name="Vertical blinds" data-desc="Window blinds fitted for cabins, meeting rooms and open-plan offices." data-chips="Fabric vanes|Cabins|Meeting rooms">
          <span class="oi-body"><img class="oi-img" src="/images/product-blinds.webp" width="1376" height="1128" alt="Vertical window blinds in a warm grey woven fabric" decoding="async" /></span>
          <span class="oi-label" aria-hidden="true">Vertical blinds</span>
        </button>

        <div class="stamp" aria-hidden="true">
          <span class="stamp-ring"></span>
          <span>Made in<br/>India</span>
        </div>
      </div>
      <div class="orbit-now">
        <p class="on-line"><b id="orbitCount">01 / 06</b><span id="orbitName">Executive chairs</span></p>
      </div>
      <p class="sr-only" id="orbitLive" aria-live="polite"></p>
    </div>
  </section>

  <!-- ================= PRODUCTS ================= -->
  <!-- One highlight per category on a pinned horizontal reel; the full range lives on /products.
       Compact by design: heading, one line and the cards share a single sticky panel. -->
  <section class="products-reel reel" id="products" aria-label="Products">
    <div class="reel-pin">
      <div class="reel-head">
        <div class="reel-head-text">
          <span class="eyebrow eyebrow-highlight">Products</span>
          <h2>Furniture for every workspace</h2>
          <p>One highlight from each range.</p>
        </div>
        <div class="reel-actions">
          <a class="btn btn-primary reel-btn" href="/products"><span>Explore range</span><span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-outline reel-btn reel-call" href="tel:+919886490295" aria-label="Call us on 98864 90295">
            <svg class="call-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span>Call us</span>
          </a>
        </div>
      </div>
      <div class="reel-track" id="reelTrack">
        <a class="reel-card" href="/products#seating">
          <span class="reel-photo"><img src="/images/cutouts/executive-chair.webp" width="537" height="851" alt="Tan leather high-back executive chair" loading="lazy" decoding="async" /></span>
          <h3>Office &amp; Executive Seating <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Office chairs, executive chairs, computer chairs.</p>
        </a>
        <a class="reel-card reel-card--wide" href="/products#office-furniture">
          <span class="reel-photo"><img src="/images/cutouts/desk.webp" width="970" height="498" alt="Walnut and charcoal office desk with a drawer unit" loading="lazy" decoding="async" /></span>
          <h3>Office Furniture <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Desks, workstations, office solutions.</p>
        </a>
        <a class="reel-card" href="/products#storage">
          <span class="reel-photo"><img src="/images/cutouts/cupboard.webp" width="599" height="788" alt="Walnut and charcoal storage cupboard" loading="lazy" decoding="async" /></span>
          <h3>Storage <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Cupboards and filing cabinets.</p>
        </a>
        <a class="reel-card reel-card--wide" href="/products#sofas">
          <span class="reel-photo"><img src="/images/cutouts/sofa.webp" width="781" height="383" alt="Three-seater fabric sofa" loading="lazy" decoding="async" /></span>
          <h3>Sofas &amp; Lounge Seating <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Sofas, lounge chairs, multi-seater chairs.</p>
        </a>
        <a class="reel-card" href="/products#cafe">
          <span class="reel-photo"><img src="/images/cutouts/bar-stool.webp" width="594" height="826" alt="Bar stool with a gold frame and white seat" loading="lazy" decoding="async" /></span>
          <h3>Café &amp; Bar Seating <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Café chairs and bar stools.</p>
        </a>
        <a class="reel-card" href="/products#blinds">
          <span class="reel-photo"><img src="/images/cutouts/blinds.webp" width="718" height="701" alt="Vertical window blinds" loading="lazy" decoding="async" /></span>
          <h3>Vertical Blinds <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Supply and installation.</p>
        </a>
        <a class="reel-card reel-card--service" href="#contact" data-req="Custom order">
          <span class="reel-photo"><img src="/images/category-custom.webp" width="720" height="600" alt="Craftsman fitting a wooden chair frame beside fabric swatches" loading="lazy" decoding="async" /></span>
          <h3>Custom / Made-to-Order <span class="arrow" aria-hidden="true">→</span></h3>
          <p>Built to your size, fabric and finish.</p>
        </a>
        <a class="reel-card reel-card--service" href="#contact" data-req="Repair">
          <span class="reel-photo"><img src="/images/category-repair.webp" width="720" height="540" alt="Hands re-upholstering a chair seat with a staple gun" loading="lazy" decoding="async" /></span>
          <h3>Repairs, Servicing &amp; Cleaning <span class="arrow" aria-hidden="true">→</span></h3>
          <p>All types of chairs and furniture.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= SERVICES ================= -->
  <section class="section section-alt band-maroon" id="services">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow eyebrow-highlight">Services</span>
        <h2>Beyond supply: upkeep included</h2>
        <p>We manufacture it, deliver it, and keep it working. One vendor for the furniture and everything it needs afterward.</p>
      </div>

      <div class="services-grid">
        <div class="service-card">
          <div class="media-frame">
            <img src="/images/service-manufacturing.webp" width="900" height="900" alt="Carpenter sanding a wooden chair frame by hand in the workshop" loading="lazy" decoding="async" />
          </div>
          <div class="service-body">
            <span class="service-label"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.5 6.5 18 3l3 3-3.5 3.5M3 21l7-7M8.5 12.5 15 6l3 3-6.5 6.5-3-3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="service-num">Manufacturing</span></span>
            <h3>Built at Our Own Facility</h3>
            <p class="svc-desc-full">Every chair, table and cupboard is manufactured at our own facility in Bangalore. We oversee production from the raw material to the finished piece.</p>
            <p class="svc-desc-short">Manufactured in-house at our own Bangalore facility.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="media-frame">
            <img src="/images/service-sales.webp" width="900" height="900" alt="Handing over a newly delivered office chair, still wrapped, to a customer" loading="lazy" decoding="async" />
          </div>
          <div class="service-body">
            <span class="service-label"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="7.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.7"/><circle cx="17.5" cy="18" r="1.6" stroke="currentColor" stroke-width="1.7"/></svg><span class="service-num">Sales</span></span>
            <h3>Direct Supply, No Middleman</h3>
            <p class="svc-desc-full">We supply chairs, tables, cupboards and blinds directly from our own stock. There is no dealer in between, so pricing and delivery stay straightforward.</p>
            <p class="svc-desc-short">Supplied directly from our own stock, no dealer markup.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="media-frame">
            <img src="/images/service-repair.webp" width="900" height="900" alt="Hand-stitching the leather seat of a chair on a workshop bench" loading="lazy" decoding="async" />
          </div>
          <div class="service-body">
            <span class="service-label"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5l-6 6 2.4 2.4 6-6a4 4 0 0 0 5-5.4l-2.6 2.6-2-2 2.6-2.6Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="service-num">Repair</span></span>
            <h3>Frame, Fabric &amp; Mechanism Repair</h3>
            <p class="svc-desc-full">Frames, mechanisms and upholstery are repaired by our own technicians. A damaged chair or sofa can usually be restored rather than replaced.</p>
            <p class="svc-desc-short">Frames, mechanisms and upholstery restored by our technicians.</p>
          </div>
        </div>
        <div class="service-card">
          <div class="media-frame">
            <img src="/images/service-cleaning.webp" width="900" height="900" alt="Deep-cleaning an office chair seat with a fabric shampoo extractor" loading="lazy" decoding="async" />
          </div>
          <div class="service-body">
            <span class="service-label"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg><span class="service-num">Cleaning</span></span>
            <h3>Fabric &amp; Leather Shampoo Wash</h3>
            <p class="svc-desc-full">Our team deep cleans fabric and leather seating on site or at our workshop. Stains, dust and daily wear are removed without new upholstery.</p>
            <p class="svc-desc-short">Fabric and leather deep-cleaned on site or at our workshop.</p>
          </div>
        </div>
      </div>
      <div class="services-cta">
        <a class="btn btn-outline reel-btn services-call" href="tel:+919886490295" aria-label="Call us on 98864 90295">
          <svg class="call-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          <span>Prefer to talk? Call us: 98864 90295</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= WHY / ABOUT ================= -->
  <section class="section" id="about">
    <div class="wrap why-grid">
      <div class="why-copy">
        <span class="eyebrow eyebrow-highlight">Why Relax Intact</span>
        <h2><span class="why-h2-full">One vendor for furniture and its upkeep</span><span class="why-h2-short">One vendor, furniture and upkeep</span></h2>
        <p class="why-desc-full">Most offices manage furniture purchase and furniture maintenance as two separate problems, with two separate vendors. <span class="brand-highlight">Relax Intact</span> handles both, for businesses furnishing a full office and for individuals furnishing a home workspace.</p>
        <p class="why-desc-short">One vendor manages both furniture and its upkeep, for offices and home workspaces alike.</p>
        <div class="slats" aria-hidden="true" style="margin-top: var(--space-5);">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="why-image">
          <img src="https://images.pexels.com/photos/5444195/pexels-photo-5444195.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/5444195/pexels-photo-5444195.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/5444195/pexels-photo-5444195.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 900px) 92vw, 38vw" width="800" height="640" alt="Modern conference room furnished with a wooden table and ergonomic chairs" loading="lazy" decoding="async" />
        </div>
      </div>

      <ul class="why-list">
        <li>
          <span class="n" aria-hidden="true"></span>
          <span>Products and services from a single vendor, no separate contractor for repairs.</span>
        </li>
        <li>
          <span class="n" aria-hidden="true"></span>
          <span>Manufacturing and supply under one roof, from cabin furniture to reception seating.</span>
        </li>
        <li>
          <span class="n" aria-hidden="true"></span>
          <span>Repair, servicing and cleaning for furniture already in use, not only new purchases.</span>
        </li>
        <li>
          <span class="n" aria-hidden="true"></span>
          <span>Direct enquiry process, with no dealer layers between you and the manufacturer.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ================= USE CASES ================= -->
  <section class="section section-alt band-gold" id="use-cases">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow eyebrow-highlight">Use cases</span>
        <h2>Built for how offices and home workspaces actually change</h2>
      </div>

      <div class="usecase-grid">
        <div class="usecase-card">
          <div class="media-frame">
            <img src="https://images.pexels.com/photos/273671/pexels-photo-273671.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/273671/pexels-photo-273671.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/273671/pexels-photo-273671.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw" width="800" height="533" alt="Newly fitted-out office pod with desks and rolling chairs" loading="lazy" decoding="async" />
          </div>
          <div class="usecase-body">
            <h3>New Office Setup</h3>
            <p>Furnishing a new office from scratch: chairs, tables, cupboards and blinds specified and supplied together.</p>
          </div>
        </div>
        <div class="usecase-card">
          <div class="media-frame">
            <img src="https://images.pexels.com/photos/28160884/pexels-photo-28160884.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/28160884/pexels-photo-28160884.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/28160884/pexels-photo-28160884.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw" width="800" height="533" alt="Renovated meeting room with new chairs and vertical blinds" loading="lazy" decoding="async" />
          </div>
          <div class="usecase-body">
            <h3>Office Renovation</h3>
            <p>Replacing or upgrading furniture during a renovation or move, without disrupting daily work.</p>
          </div>
        </div>
        <div class="usecase-card">
          <div class="media-frame">
            <img src="https://images.pexels.com/photos/31567147/pexels-photo-31567147.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/31567147/pexels-photo-31567147.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/31567147/pexels-photo-31567147.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw" width="800" height="533" alt="Craftsman restoring a wooden chair frame in a workshop" loading="lazy" decoding="async" />
          </div>
          <div class="usecase-body">
            <h3>Furniture Maintenance</h3>
            <p>Keeping existing chairs and sofas in working condition through repair and cleaning.</p>
          </div>
        </div>
        <div class="usecase-card">
          <div class="media-frame">
            <img src="https://images.pexels.com/photos/19199263/pexels-photo-19199263.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/19199263/pexels-photo-19199263.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/19199263/pexels-photo-19199263.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw" width="800" height="533" alt="Rows of desks and chairs in a classroom" loading="lazy" decoding="async" />
          </div>
          <div class="usecase-body">
            <h3>Schools &amp; Institutions</h3>
            <p>Classroom furniture, staff seating and bulk institutional orders, supplied and maintained together.</p>
          </div>
        </div>
        <div class="usecase-card">
          <div class="media-frame">
            <img src="https://images.pexels.com/photos/3958959/pexels-photo-3958959.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800" srcset="https://images.pexels.com/photos/3958959/pexels-photo-3958959.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=400 400w, https://images.pexels.com/photos/3958959/pexels-photo-3958959.jpeg?auto=compress&cs=tinysrgb&fm=webp&w=800 800w" sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 30vw" width="800" height="533" alt="Home office with desk, leather chair and natural light" loading="lazy" decoding="async" />
          </div>
          <div class="usecase-body">
            <h3>Home &amp; Individual Workspaces</h3>
            <p>Single chairs, desks and blinds for home offices and individual buyers, not only bulk office orders.</p>
          </div>
        </div>
        <div class="usecase-card usecase-cta">
          <div class="media-frame usecase-cta-panel">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3C7 3 3 6.6 3 11c0 2.4 1.2 4.6 3.2 6.1-.1 1-.5 2-1.2 2.9-.2.2 0 .6.3.5 1.6-.3 3-1 4-1.8.9.2 1.8.3 2.7.3 5 0 9-3.6 9-8s-4-8-9-8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.5 10.5h7M8.5 13.5h4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </div>
          <div class="usecase-body">
            <h3>Not Sure What You Need?</h3>
            <p>Tell us a little about your space, and we'll help you work out the right furniture for it.</p>
            <a class="card-enquire" href="#contact">Talk to us →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CONTACT ================= -->
  <section class="section section-alt band-rose" id="contact">
    <div class="wrap contact-grid">
      <div class="contact-copy">
        <span class="eyebrow eyebrow-highlight">Contact</span>
        <h2>Let's set up your workspace.</h2>
        <p>Tell us what you need. We'll get back with options, pricing and lead times.</p>

        <div class="contact-info">
          <div class="contact-info-row">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
