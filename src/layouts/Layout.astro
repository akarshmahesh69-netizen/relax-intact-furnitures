---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** 'home' (index) or 'products' — drives the small set of header/footer link differences
      documented in CLAUDE.md (home uses on-page #hash links where products.html used
      index.html#hash links to jump back to the home page's sections). */
  page: 'home' | 'products';
}

const { title, description, ogTitle, ogDescription, page } = Astro.props;

const homeHref = page === 'home' ? '#home' : '/';
const servicesHref = page === 'home' ? '#services' : '/#services';
const aboutHref = page === 'home' ? '#about' : '/#about';
const waLink = 'https://wa.me/919886490295?text=Hi%20Relax%20Intact%2C%20I%27d%20like%20a%20quote.';
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>document.documentElement.classList.add('js');</script>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#6E1220" />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle ?? title} />
<meta property="og:description" content={ogDescription ?? description} />
<meta property="og:image" content="https://images.pexels.com/photos/36733323/pexels-photo-36733323.jpeg?auto=compress&cs=tinysrgb&fm=jpg&w=1200" />
<link rel="icon" type="image/png" href="/images/favicon.png" />
<link rel="apple-touch-icon" href="/images/favicon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://images.pexels.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,600;1,700&display=swap" rel="stylesheet">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap nav">
    <a href={homeHref} class="logo" aria-label="Relax Intact Furnitures, home">
      <img class="logo-mark" src="/images/logo-mark.png" width="640" height="283" alt="" />
      <span class="logo-text">
        <span class="lt-name">Relax Intact</span>
        <span class="lt-sub">Furnitures</span>
        <img class="tagline-hl" src="/images/logo-tagline.png" width="520" height="28" alt="Elevate your comfort" />
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links" id="navLinks">
        <li><a href={homeHref}>Home</a></li>
        <li><a href="/products" aria-current={page === 'products' ? 'true' : undefined}>Products</a></li>
        <li><a href={servicesHref}>Services</a></li>
        <li><a href={aboutHref}>About</a></li>
        <li><a href="#contact">Contact</a></li>
        <li class="nav-quote"><a href={waLink} class="btn btn-primary" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"><svg class="wa-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5v-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 8.5h7M8.5 11.5h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>WhatsApp</span></a></li>
      </ul>
    </nav>

    <div class="nav-cta">
      <a href={waLink} class="btn btn-primary" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"><svg class="wa-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5v-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 8.5h7M8.5 11.5h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>WhatsApp</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
        <span></span>
      </button>
    </div>
  </div>
  <div class="scroll-rail" aria-hidden="true">
    <span class="rail-fill"></span>
    <img class="rail-chair" src="/images/chair-cutout.webp" width="240" height="252" alt="" />
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-logo-plate">
          <img class="fl-mark" src="/images/logo-mark.png" width="640" height="283" alt="" loading="lazy" />
          <img class="fl-word" src="/images/logo-wordmark.png" width="800" height="128" alt="Relax Intact Furnitures" loading="lazy" />
          <img class="tagline-hl fl-tag" src="/images/logo-tagline.png" width="520" height="28" alt="Elevate your comfort" loading="lazy" />
        </span>
        <p>Office furniture manufacturing, sales, and chair &amp; sofa repair and cleaning, based in Bangalore.</p>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href={homeHref}>Home</a></li>
          <li><a href="/products">Products</a></li>
          <li><a href={servicesHref}>Services</a></li>
          <li><a href={aboutHref}>About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li><a href="tel:+919886490295">98864 90295</a></li>
          <li><a href="#contact">Lalbagh Fort Road, Minerva Circle, Bangalore 560 004</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Relax Intact Furnitures.</span>
      <span>Made in India</span>
    </div>
  </div>
</footer>

<a class="wa-float" href={waLink} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg class="wa-ico" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5v-8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 8.5h7M8.5 11.5h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
</a>
<button type="button" class="to-top" id="toTop" aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script src="/vendor/gsap.min.js" is:inline></script>
<script src="/scripts/site.js" is:inline></script>
</body>
</html>
